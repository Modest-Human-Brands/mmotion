{
  "name": "mmotion",
  "version": "0.1.0",
  "private": true,
  "description": "100% in-browser 3D device motion studio. Pick a scene, apply your brand and render MP4 or still images locally.",
  "license": "MIT",
  "author": "Shirsendu Bairagi <shirsendu2001@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shba007/mockup-renderer.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "vp dev",
    "detect": "gitleaks git --verbose",
    "lint": "vp lint . --fix",
    "format": "vp fmt src/",
    "test:unit": "vp test",
    "build": "vp build",
    "preview": "vp preview",
    "docker:build": "docker build --build-arg VERSION=dev --build-arg BUILD_TIME=now -t mmotion:dev .",
    "docker:start": "docker run --detach --name mmotion-dev --env-file .env -p 2000:8080 mmotion:dev"
  },
  "dependencies": {
    "@rive-app/webgl2-advanced": "2.44.2",
    "@tresjs/cientos": "5.9.3",
    "@tresjs/core": "5.9.3",
    "@tresjs/post-processing": "3.10.0",
    "@vueuse/core": "^15.0.0",
    "gsap": "3.15.0",
    "html-to-image": "1.11.13",
    "mediabunny": "1.61.3",
    "notform": "^3.0.1",
    "pinia": "^4.0.3",
    "shaders": "4.0.4",
    "three": "0.186.1",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@fontsource-variable/exo-2": "^5.3.0",
    "@iconify-json/lucide": "^1.2.142",
    "@iconify-json/simple-icons": "^1.2.99",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/three": "0.186.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "unplugin-fonts": "^2.0.0",
    "unplugin-icons": "^24.0.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-plus": "1.1.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0"
  },
  "engines": {
    "bun": "^1.2.9",
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0",
    "pnpm": "^9.15.0 || ^10.2.0 || ^11.0.0"
  },
  "packageManager": "bun@1.4.3"
}